generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GamePhase {
  campPhase
  battlePhase
}

model User {
  // Supabase auth user id (uuid). Supplied by the application at insert
  // time, never generated by Prisma — Supabase Auth owns identity creation.
  id        String   @id @db.Uuid
  createdAt DateTime @default(now())

  game Game?
}

model Game {
  id     String @id @default(uuid()) @db.Uuid
  // Unique enforces one save slot per user (CLAUDE.md -> "Persistence &
  // save model"); dropping this constraint is the migration path to
  // multiple save slots later.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  playerRoster Json
  gold         Int
  day          Int
  phase        GamePhase
  // Optimistic-concurrency counter; every mutating save is conditional on
  // the revision the intent was based on, and increments it (CLAUDE.md ->
  // "Persistence & save model", added Phase 8).
  revision     Int      @default(0)
  // The character shop's eight slots (locked / offering a template id /
  // sold), rolled on the server at every camp start; validated by
  // parsePersistedCharacterShopSlots (Phase 9).
  characterShopSlots Json
  // How deep the run has gone; incremented with day on battle -> camp
  // (Phase 13).
  depth Int @default(1)
  // The stored enemy for the battle in progress ({ enemyFactionId,
  // enemyCharacters, battleSeed }), generated once at camp -> battle so
  // every re-resolve replays the same battle; null in camp. Validated by
  // parsePersistedEnemyEncounter (Phase 13).
  enemyEncounter Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A displayName column is a known future addition, for showing PvP
  // opponent names. Deliberately omitted for now.
}
