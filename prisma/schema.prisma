generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GamePhase {
  campPhase
  battlePhase
}

model User {
  // Supabase auth user id (uuid). Supplied by the application at insert
  // time, never generated by Prisma — Supabase Auth owns identity creation.
  id        String   @id @db.Uuid
  createdAt DateTime @default(now())

  game Game?
}

model Game {
  id     String @id @default(uuid()) @db.Uuid
  // Unique enforces one save slot per user (CLAUDE.md -> "Persistence &
  // save model"); dropping this constraint is the migration path to
  // multiple save slots later.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  playerRoster Json
  gold         Int
  day          Int
  phase        GamePhase

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A displayName column is a known future addition, for showing PvP
  // opponent names. Deliberately omitted for now.
}
