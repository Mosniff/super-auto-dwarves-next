# Real values live in .env.local (gitignored). This file documents names only.

# Postgres (Supabase). DIRECT_URL is used by the Prisma CLI for migrations;
# DATABASE_URL is used by the app through the PrismaPg adapter.
DATABASE_URL=
DIRECT_URL=

# Supabase Auth. The publishable key (sb_publishable_...) is designed to be public.
# NEVER put a secret key (sb_secret_...) or the legacy service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=